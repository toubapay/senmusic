# ProMusic — environment variables
# Copy to .env and fill in real values. Grouped by which piece reads them.

# --- Database (lib/db.js, transcoder, royalties-job) ---
# Port 5433 on the host by default (docker-compose.yml maps 5433->5432
# because 5432 may already be taken locally); inside docker-compose the
# api container reaches Postgres at db:5432 instead (compose sets this).
DATABASE_URL=postgres://promusic:promusic@localhost:5433/promusic

# --- Auth (lib/auth.js — normal user session JWTs) ---
JWT_SECRET=replace-with-a-long-random-secret

# --- GCS buckets (artist-uploads.js, streaming.js, offline.js, transcoder) ---
ORIGINALS_BUCKET=promusic-originals
HLS_BUCKET=promusic-hls
# Path to a GCS service-account key JSON, or omit to use ADC
GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json

# --- Streaming entitlement (streaming.js) ---
STREAM_TOKEN_SECRET=replace-with-a-different-long-random-secret
API_BASE_URL=http://localhost:8080
APP_BASE_URL=http://localhost:3000

# --- Cloud CDN signed URLs (lib/cdn-signer.js) ---
CDN_BASE_URL=https://cdn.yourdomain.sn
CDN_KEY_NAME=stream-key-1
CDN_KEY_B64=

# --- PayDunya (lib/paydunya.js) ---
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# --- Meilisearch (lib/meili.js) ---
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=

# --- Royalties job (compute-royalties.js) ---
ARTIST_SHARE=0.60

# --- Server ---
PORT=8080
